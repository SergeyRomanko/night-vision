// Navy ~ 0.2-lite

[OVERLAY name=Orders, ctx=Canvas, version=1.0.0]

prop('buyColor', {  type: 'color', def: '#08b2c6' })
prop('sellColor', {  type: 'color', def: '#e42633' })

draw(ctx) {

    const data = $core.data
    const view = $core.view
	const layout = $core.layout

	ctx.save()
	
    for (var item of data)
	{
		let widthY = 70;
		let startX = layout.width - widthY - 10;
		let y      = layout.value2y(item.Price)
		let color  = item.Side == 1 
			? $core.props.colors.candleDw 
			: $core.props.colors.candleUp;
		
		if (item.Shadow != undefined)
		{
			var shadowY = layout.value2y(item.Shadow);
			var shadowHeight = Math.abs(y - shadowY);
			if (shadowHeight > 1)
			{
				ctx.fillStyle = convertToRGBA(color, 0.1);
				
				ctx.fillRect(0, Math.min(y, shadowY), layout.width, shadowHeight);
					
				ctx.strokeStyle = convertToRGBA(color, 0.25);
				ctx.beginPath()
				ctx.moveTo(0, shadowY + 0.5)
				ctx.lineTo(layout.width + 0.5, shadowY + 0.5)
				ctx.stroke()
			}
		}
		
		ctx.strokeStyle = color;
		
		ctx.beginPath()
		
		ctx.moveTo(0, y + 0.5)
		ctx.lineTo(layout.width + 0.5, y + 0.5)
		
		ctx.stroke()
		
		drawRoundedRect(
			ctx, 
			startX, 
			y - 13 / 2.0,
			widthY, 13, 3, $core.props.colors.back, ctx.strokeStyle
		);
		
		ctx.font = "10px -apple-system, BlinkMacSystemFont, Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue, sans-serif"
		ctx.fillStyle = $core.props.colors.textLG
		ctx.textAlign = 'left'
		ctx.fillText(item.Quantity, startX + 4, y + 3 )
		
		ctx.fillStyle = $core.props.colors.text
		ctx.textAlign = 'right'
		ctx.fillText(item.Price, startX + widthY - 4, y + 3)
    }
	
	ctx.restore()
}

function drawRoundedRect(ctx, x, y, width, height, radius, fillColor, strokeColor) {
    ctx.beginPath();
    ctx.moveTo(x + radius, y); // Top-left corner
    ctx.lineTo(x + width - radius, y);
    ctx.arcTo(x + width, y, x + width, y + radius, radius); // Top-right corner
    ctx.lineTo(x + width, y + height - radius);
    ctx.arcTo(x + width, y + height, x + width - radius, y + height, radius); // Bottom-right
    ctx.lineTo(x + radius, y + height);
    ctx.arcTo(x, y + height, x, y + height - radius, radius); // Bottom-left
    ctx.lineTo(x, y + radius);
    ctx.arcTo(x, y, x + radius, y, radius); // Top-left

    ctx.closePath();

    // Fill the rectangle
    ctx.fillStyle = fillColor;
    ctx.fill();

    // Stroke the rectangle
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = 1;
    ctx.stroke();
}


